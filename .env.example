# Agentic AI Research Assistant - Environment Configuration
# Copy this file to .env and fill in your actual API keys

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# Anthropic Claude Configuration (Optional)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-opus-20240229

# Tavily Search API (Web Search)
TAVILY_API_KEY=tvly-...

# Research Configuration
RESEARCH_DEPTH=comprehensive  # quick, standard, comprehensive
MAX_SEARCH_RESULTS=10
MAX_TOKENS=4096
TEMPERATURE=0.7

# Logging Configuration
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR
LOG_FILE=research_assistant.log

# API Server Configuration (for future REST API)
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Database Configuration (for future features)
DATABASE_URL=sqlite:///./research_assistant.db

# Application Settings
DEBUG=false
ENVIRONMENT=development  # development, staging, production
